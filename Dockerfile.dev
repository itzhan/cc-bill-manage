FROM node:22-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
EXPOSE 3100
# Install deps + generate prisma client on every start (cheap thanks to npm cache).
# The actual source is bind-mounted so edits hot-reload.
CMD ["sh","-c","npm install && npx prisma generate && npm run dev"]
